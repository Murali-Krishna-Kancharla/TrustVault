# TrustVault Security Configuration
SECRET_KEY=trustvault_super_secret_jwt_hmac_key_min_32_bytes_long_prod
AUDIT_HMAC_SECRET=trustvault_immutable_audit_log_ledger_hmac_secret_key_2026
STORAGE_ENCRYPTION_KEY=trustvault_aes_256_gcm_storage_master_key_32_bytes!
DATABASE_URL=sqlite:///./trustvault.db
VAULT_STORAGE_DIR=./vault_storage
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
ACCESS_TOKEN_EXPIRE_MINUTES=60
